{
  "name": "@local/whale-sentinel",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "小鲸哨：DSH 轻量任务雷达。收起时坐姿办公，展开后站到看板旁指向任务，两种尺寸可分别调整。",
  "exports": {
    ".": "./release-2.1.0.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./assets/*": "./assets/*",
    "./icon": "./icon.png",
    "./README.md": "./README.md",
    "./docs/*": "./docs/*",
    "./README.en.md": "./README.en.md"
  },
  "files": [
    "index.js",
    "release-2.1.0.js",
    "notification-format.js",
    "activation-queue.js",
    "win-activation.js",
    "win-activation.ps1",
    "host.js",
    "task-state.js",
    "native.js",
    "native-wake.ps1",
    "client.js",
    "src/*.js",
    "scripts/build-client.mjs",
    "scripts/verify-release.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "icon.svg",
    "ATTRIBUTION.md",
    "README.md",
    "docs/*.md",
    "docs/*.py",
    "check.mjs",
    "*.test.mjs",
    "assets/*.png",
    "assets/*.webp",
    "assets/artwork.json",
    "docs/state-handbook.png",
    "docs/session-flow.png",
    "docs/controls-guide.png",
    "scripts/prepare-soft-artwork.py",
    "scripts/build-artwork.py",
    "scripts/build-it-artwork.py",
    "scripts/split-frames.py",
    "docs/panel-preview.png",
    "docs/notification-preview.png",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
